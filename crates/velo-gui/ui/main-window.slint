// The main window: menu bar, toolbar, the Categories pane beside the download list, and the
// status bar.

import { Button, CheckBox, VerticalBox } from "std-widgets.slint";
import { AboutPanel } from "about.slint";
import { CategoriesPane, CategoryItem } from "categories.slint";
import { DownloadList, DownloadRow, QueueChoice } from "download-list.slint";
import { StatusBar } from "status-bar.slint";
import { Appearance, Theme } from "theme.slint";
import { Toolbar } from "toolbar.slint";

// A vertical bar between two panes; dragging it moves `position`.
component Splitter inherits Rectangle {
    in-out property <length> position;
    in property <length> minimum;
    in property <length> maximum;

    width: 5px;
    background: touch.pressed || touch.has-hover ? Theme.border : transparent;

    touch := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.position = max(root.minimum, min(root.maximum,
                    root.position + self.mouse-x - self.pressed-x));
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <[CategoryItem]> categories;
    in-out property <string> selected-category: "all";
    in-out property <bool> show-categories: true;
    in property <[DownloadRow]> downloads;
    in-out property <int> selected-id: -1;
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;
    in property <string> status-message: "Ready";
    in property <string> status-summary;

    // Toolbar and menu state, set from the selected download.
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <bool> can-stop-all;
    in property <bool> can-delete;
    in property <bool> can-delete-completed;
    in property <bool> can-start-queue;
    in property <bool> can-stop-queue;
    in property <[QueueChoice]> queue-choices;

    callback add-url();
    callback resume();
    callback stop();
    callback stop-all();
    callback delete();
    callback delete-completed();
    callback category-selected(key: string);
    callback category-toggled(key: string);
    callback add-category();
    callback edit-category(key: string);
    callback delete-category(key: string);
    callback selection-changed(id: int);
    callback download-activated(id: int);
    callback sort(column: int);
    callback move-selection(delta: int);
    callback resume-download(id: int);
    callback stop-download(id: int);
    callback delete-download(id: int);
    callback open-file(id: int);
    callback open-folder(id: int);
    callback properties(id: int);
    // The user confirmed deleting download `id`, and its finished file too if `delete-file`.
    callback delete-confirmed(id: int, delete-file: bool);
    callback appearance-changed(appearance: Appearance);
    callback options();
    callback scheduler();
    callback start-queue();
    callback stop-queue();
    callback enqueue(id: int, queue: int);
    callback dequeue(id: int);
    callback quit();

    private property <length> categories-width: 200px;
    private property <int> pending-delete-id: -1;
    private property <string> pending-delete-name;
    private property <bool> pending-delete-complete;
    private property <bool> pending-delete-file;

    // Asks whether to delete download `id`, named `name`; a `complete` one can take its file
    // along.
    public function ask-delete(id: int, name: string, complete: bool) {
        root.pending-delete-id = id;
        root.pending-delete-name = name;
        root.pending-delete-complete = complete;
        root.pending-delete-file = false;
        confirm-delete.show();
    }

    title: "Velo Download Manager";
    icon: @image-url("../../../assets/icons/velo.svg");
    preferred-width: 1000px;
    preferred-height: 620px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.window;

    MenuBar {
        Menu {
            title: "Tasks";
            MenuItem {
                title: "Add New Download…";
                activated => { root.add-url(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Exit";
                activated => { root.quit(); }
            }
        }
        Menu {
            title: "Downloads";
            MenuItem {
                title: "Stop All";
                enabled: root.can-stop-all;
                activated => { root.stop-all(); }
            }
            MenuItem {
                title: "Delete All Completed";
                enabled: root.can-delete-completed;
                activated => { root.delete-completed(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Scheduler…";
                activated => { root.scheduler(); }
            }
            MenuItem {
                title: "Start Queue";
                enabled: root.can-start-queue;
                activated => { root.start-queue(); }
            }
            MenuItem {
                title: "Stop Queue";
                enabled: root.can-stop-queue;
                activated => { root.stop-queue(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Options…";
                activated => { root.options(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Categories";
                checkable: true;
                checked: root.show-categories;
                activated => { root.show-categories = !root.show-categories; }
            }
            Menu {
                title: "Theme";
                MenuItem {
                    title: "System";
                    checkable: true;
                    checked: Theme.appearance == Appearance.system;
                    activated => {
                        Theme.apply(Appearance.system);
                        root.appearance-changed(Appearance.system);
                    }
                }
                MenuItem {
                    title: "Light";
                    checkable: true;
                    checked: Theme.appearance == Appearance.light;
                    activated => {
                        Theme.apply(Appearance.light);
                        root.appearance-changed(Appearance.light);
                    }
                }
                MenuItem {
                    title: "Dark";
                    checkable: true;
                    checked: Theme.appearance == Appearance.dark;
                    activated => {
                        Theme.apply(Appearance.dark);
                        root.appearance-changed(Appearance.dark);
                    }
                }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "About Velo";
                activated => { about.show(); }
            }
        }
    }

    about := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 280px) / 2;
        width: 420px;
        height: 280px;
        close-policy: close-on-click-outside;
        AboutPanel {
            version: root.version;
            close => { about.close(); }
        }
    }

    confirm-delete := PopupWindow {
        x: (root.width - 400px) / 2;
        y: (root.height - 150px) / 2;
        width: 400px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.window;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalBox {
                Text {
                    text: "Delete “" + root.pending-delete-name + "” from the list?";
                    wrap: word-wrap;
                    font-weight: 600;
                    color: Theme.text;
                }
                if !root.pending-delete-complete: Text {
                    text: "The part of it downloaded so far is deleted too.";
                    wrap: word-wrap;
                    color: Theme.text-muted;
                }
                CheckBox {
                    visible: root.pending-delete-complete;
                    checked <=> root.pending-delete-file;
                    text: "Also delete the file from disk";
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Delete";
                        primary: true;
                        clicked => {
                            confirm-delete.close();
                            root.delete-confirmed(root.pending-delete-id,
                                root.pending-delete-complete && root.pending-delete-file);
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => { confirm-delete.close(); }
                    }
                }
            }
        }
    }

    VerticalLayout {
        Toolbar {
            can-resume: root.can-resume;
            can-stop: root.can-stop;
            can-stop-all: root.can-stop-all;
            can-delete: root.can-delete;
            can-delete-completed: root.can-delete-completed;
            can-start-queue: root.can-start-queue;
            can-stop-queue: root.can-stop-queue;
            add-url => { root.add-url(); }
            resume => { root.resume(); }
            stop => { root.stop(); }
            stop-all => { root.stop-all(); }
            delete => { root.delete(); }
            delete-completed => { root.delete-completed(); }
            options => { root.options(); }
            scheduler => { root.scheduler(); }
            start-queue => { root.start-queue(); }
            stop-queue => { root.stop-queue(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            if root.show-categories: CategoriesPane {
                width: root.categories-width;
                items: root.categories;
                selected: root.selected-category;
                selected-changed(key) => {
                    root.selected-category = key;
                    root.category-selected(key);
                }
                toggle-expanded(key) => { root.category-toggled(key); }
                add-category => { root.add-category(); }
                edit-category(key) => { root.edit-category(key); }
                delete-category(key) => { root.delete-category(key); }
            }
            if root.show-categories: Splitter {
                position <=> root.categories-width;
                minimum: 140px;
                maximum: root.width / 2;
            }

            DownloadList {
                horizontal-stretch: 1;
                rows: root.downloads;
                queue-choices: root.queue-choices;
                enqueue(id, queue) => { root.enqueue(id, queue); }
                dequeue(id) => { root.dequeue(id); }
                selected-id <=> root.selected-id;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                selection-changed(id) => { root.selection-changed(id); }
                activated(id) => { root.download-activated(id); }
                sort(column) => { root.sort(column); }
                move-selection(delta) => { root.move-selection(delta); }
                resume(id) => { root.resume-download(id); }
                stop(id) => { root.stop-download(id); }
                delete(id) => { root.delete-download(id); }
                open-file(id) => { root.open-file(id); }
                open-folder(id) => { root.open-folder(id); }
                properties(id) => { root.properties(id); }
            }
        }

        StatusBar {
            message: root.status-message;
            summary: root.status-summary;
        }
    }
}
