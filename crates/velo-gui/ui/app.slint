import { AboutSlint, Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Appearance, Theme } from "theme.slint";

export { Appearance, Theme }

// The About dialog's content. Slint's royalty-free license requires the AboutSlint attribution.
component AboutPanel inherits Rectangle {
    in property <string> version;
    callback close();
    background: Theme.window;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 8px;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;

    VerticalBox {
        alignment: start;
        HorizontalBox {
            Image {
                source: @image-url("../../../assets/icons/velo.svg");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "Velo Download Manager";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: "Version " + root.version;
                    color: Theme.text-muted;
                }
            }
        }
        Text {
            text: "MIT license. Icons by Lucide (ISC).";
            color: Theme.text-muted;
        }
        AboutSlint {
            height: 120px;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                clicked => { root.close(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> version;

    title: "Velo Download Manager";
    icon: @image-url("../../../assets/icons/velo.svg");
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.window;

    about := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 280px) / 2;
        width: 420px;
        height: 280px;
        close-policy: close-on-click-outside;
        AboutPanel {
            version: root.version;
            close => { about.close(); }
        }
    }

    VerticalLayout {
        // Header band; the IDM-style menu bar and toolbar replace it on Day 11.
        Rectangle {
            height: 56px;
            background: Theme.panel;
            HorizontalBox {
                Image {
                    source: @image-url("../../../assets/icons/velo.svg");
                    width: 32px;
                }
                Text {
                    text: "Velo Download Manager";
                    vertical-alignment: center;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Rectangle { horizontal-stretch: 1; }
                for choice in [
                    { value: Appearance.system, label: "System", icon: @image-url("../../../assets/icons/lucide/monitor.svg") },
                    { value: Appearance.light, label: "Light", icon: @image-url("../../../assets/icons/lucide/sun.svg") },
                    { value: Appearance.dark, label: "Dark", icon: @image-url("../../../assets/icons/lucide/moon.svg") },
                ]: Button {
                    text: choice.label;
                    icon: choice.icon;
                    colorize-icon: true;
                    checkable: true;
                    checked: Theme.appearance == choice.value;
                    clicked => { Theme.apply(choice.value); }
                }
                Button {
                    text: "About";
                    icon: @image-url("../../../assets/icons/lucide/info.svg");
                    colorize-icon: true;
                    clicked => { about.show(); }
                }
            }
        }

        // Empty state until the download list arrives (Day 12).
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 8px;
            Text {
                text: "No downloads yet";
                horizontal-alignment: center;
                font-size: 20px;
                color: Theme.text;
            }
            Text {
                text: "Velo " + root.version + ": the download engine arrives in milestone M1.";
                horizontal-alignment: center;
                color: Theme.text-muted;
            }
        }

        // Status bar.
        Rectangle {
            height: 24px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Ready";
                    vertical-alignment: center;
                    font-size: 12px;
                    color: Theme.text-muted;
                }
            }
        }
    }
}
